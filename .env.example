# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Application Configuration
NEXT_PUBLIC_CONFERENCE_ID=conf-2027-001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Razorpay Payment Gateway (Test/Live)
# Client-side checkout key ID
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Server-side only private credentials (DO NOT EXPOSE TO CLIENT)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Supabase Service Role Key (Server-side only for trusted payment verification)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

